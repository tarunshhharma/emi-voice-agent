OPENAI_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
# Optional: override the default model (gpt-6-luna)
OPENAI_MODEL=
# Optional: sarvam (default) or deepgram
STT_PROVIDER=
# Optional: ElevenLabs voice for Priya (default: premade "Sarah")
ELEVENLABS_VOICE_ID=
# Optional, testing only: allow calls outside 8 am-7 pm IST (logged as a warning)
ALLOW_OFF_HOURS=
# Optional: sarvam (default, Indian voices) or elevenlabs (fallback)
TTS_PROVIDER=
# Optional: Sarvam voices (defaults: aparna_hi_customer / aparna_en_companion)
SARVAM_TTS_VOICE_HI=
SARVAM_TTS_VOICE_EN=
# Public demo only: callers must enter this code, and at most this many spoken calls per day (UTC)
DEMO_ACCESS_CODE=
MAX_CALLS_PER_DAY=
# Optional: database location (default sqlite:///emi.db)
DATABASE_URL=
